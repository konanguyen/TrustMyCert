#!/system/bin/sh
# TrustMyCert WebUI CGI for the Magisk action.sh HTTP fallback.
#
# POST /cgi-bin/api?token=<ui.token>   body: <tmc args>
# Responds with {"errno":N,"stdout":"...","stderr":"..."}.
#
# The token is generated by action.sh (root-only file) and blocks other local
# apps from changing the target list through 127.0.0.1. Only a strict command
# whitelist is accepted; the tmc CLI is never invoked through a shell string.

set -f
set -u
umask 077

TOKEN_FILE=${TMC_UI_TOKEN_FILE:-/data/adb/trustmycert/ui.token}
TMC_BIN=${TMC_BIN:-/data/adb/modules/trustmycert/bin/tmc}
ERR_FILE=${TMC_CGI_ERR_FILE:-/data/adb/trustmycert/.cgi_err.$$}

json_escape() {
    awk 'BEGIN { ORS="" }
        {
            gsub(/\\/, "\\\\")
            gsub(/"/, "\\\"")
            gsub(/\t/, "\\t")
            gsub(/\r/, "")
            print $0 "\\n"
        }'
}

respond() {
    _errno=$1
    _out=$2
    _err=$3
    printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
    printf '{"errno":%d,"stdout":"' "$_errno"
    printf '%s' "$_out" | json_escape
    printf '","stderr":"'
    printf '%s' "$_err" | json_escape
    printf '"}\n'
    rm -f "$ERR_FILE"
    exit 0
}

fail() {
    _code=$1
    _msg=$2
    printf 'Status: %s\r\n' "$_code"
    respond 1 '' "$_msg"
}

[ "${REQUEST_METHOD:-GET}" = "POST" ] || fail "405 Method Not Allowed" "POST only"

TOKEN=""
for pair in ${QUERY_STRING:-}; do
    case "$pair" in
        token=*) TOKEN=${pair#token=} ;;
    esac
done

EXPECTED=""
[ -f "$TOKEN_FILE" ] && EXPECTED=$(cat "$TOKEN_FILE" 2>/dev/null)
[ -n "$EXPECTED" ] || fail "503 Service Unavailable" "UI token not initialized; start the module action"
[ "$TOKEN" = "$EXPECTED" ] || fail "403 Forbidden" "invalid token"

# Body is a plain fixed command (max 256 bytes); no URL decoding needed.
CMD=$(head -c 256 2>/dev/null)
CMD=$(printf '%s' "$CMD" | tr -d '\r\n')

# Strict whitelist: exactly the tmc commands exposed by the UI.
case "$CMD" in
    "list" | "apps" | "path" | "validate") ;;
    "get enabled" | "get bypass" | "get verbose" | "get match_subprocesses" | \
        "get targets" | "get path") ;;
    "set enabled 0" | "set enabled 1" | "set bypass 0" | "set bypass 1" | \
        "set verbose 0" | "set verbose 1" | \
        "set match_subprocesses 0" | "set match_subprocesses 1") ;;
    "add "* | "remove "*)
        PKG=${CMD#* }
        case "$PKG" in
            "" | *[!A-Za-z0-9_.]* | system_server)
                fail "400 Bad Request" "invalid package name"
                ;;
        esac
        ;;
    *) fail "400 Bad Request" "invalid command" ;;
esac

[ -f "$TMC_BIN" ] || fail "500 Internal Server Error" "tmc CLI not found"
OUT=$("$TMC_BIN" $CMD 2>"$ERR_FILE")
RC=$?
ERR=$(cat "$ERR_FILE" 2>/dev/null)
respond "$RC" "$OUT" "$ERR"
